# Support Ticket Management System - Environment Configuration Template
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control - it contains secrets

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# For H2 (Default - Development/Testing)
# DB_URL=jdbc:h2:file:./data/ticket_management;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# DB_DRIVER=org.h2.Driver
# DB_USERNAME=sa
# DB_PASSWORD=
# JPA_DIALECT=org.hibernate.dialect.H2Dialect

# For PostgreSQL (Production)
# DB_URL=jdbc:postgresql://localhost:5432/ticket_management
# DB_DRIVER=org.postgresql.Driver
# DB_USERNAME=postgres
# DB_PASSWORD=your_secure_password_here
# JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# =============================================================================
# JPA/HIBERNATE CONFIGURATION
# =============================================================================

# Schema Management (update=preserve data, create-drop=recreate on restart)
JPA_DDL_AUTO=update

# SQL Logging (set to false in production)
JPA_SHOW_SQL=false

# =============================================================================
# H2 CONSOLE (Development Only)
# =============================================================================

# Enable H2 console (DISABLE in production for security)
H2_CONSOLE_ENABLED=true

# =============================================================================
# CONNECTION POOL SETTINGS
# =============================================================================

DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=600000
DB_POOL_MAX_LIFETIME=1800000

# =============================================================================
# FLYWAY MIGRATIONS
# =============================================================================

# Enable for PostgreSQL production deployments
FLYWAY_ENABLED=false
FLYWAY_VALIDATE=false

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

SERVER_PORT=8080

# =============================================================================
# LOGGING LEVELS
# =============================================================================

LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_SQL=DEBUG

# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# Local Development (H2):
# No environment variables needed - uses defaults

# Production (PostgreSQL):
# DB_URL=jdbc:postgresql://prod-db-server:5432/ticket_management
# DB_DRIVER=org.postgresql.Driver  
# DB_USERNAME=ticket_app
# DB_PASSWORD=super_secure_production_password
# JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect
# JPA_DDL_AUTO=validate
# JPA_SHOW_SQL=false
# H2_CONSOLE_ENABLED=false
# FLYWAY_ENABLED=true
# LOG_LEVEL_APP=INFO
# LOG_LEVEL_SQL=WARN

# Docker (PostgreSQL):
# DB_URL=jdbc:postgresql://postgres-container:5432/ticket_management
# DB_USERNAME=ticket_user
# DB_PASSWORD=${POSTGRES_PASSWORD}
# H2_CONSOLE_ENABLED=false