# Production Environment Configuration
# PostgreSQL database with security optimizations

# Database (PostgreSQL - use your production credentials)
DB_URL=jdbc:postgresql://localhost:5432/ticket_management
DB_DRIVER=org.postgresql.Driver
DB_USERNAME=ticket_app
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD
JPA_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# JPA Configuration (production settings)
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

# H2 Console (DISABLED for security)
H2_CONSOLE_ENABLED=false

# Connection Pool (optimized for production)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_CONNECTION_TIMEOUT=30000
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_MAX_LIFETIME=1800000

# Flyway (enabled for controlled schema management)
FLYWAY_ENABLED=true
FLYWAY_VALIDATE=true

# Server
SERVER_PORT=8080

# Logging (production levels)
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO
LOG_LEVEL_SPRING=WARN
LOG_LEVEL_SQL=WARN