# Development Environment Configuration
# H2 file-based database with persistence

# Database (H2 - persists data locally)
DB_URL=jdbc:h2:file:./data/ticket_management;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=
JPA_DIALECT=org.hibernate.dialect.H2Dialect

# JPA Configuration
JPA_DDL_AUTO=update
JPA_SHOW_SQL=true

# H2 Console
H2_CONSOLE_ENABLED=true

# Connection Pool (small for development)
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1

# Flyway (disabled for H2)
FLYWAY_ENABLED=false

# Server
SERVER_PORT=8080

# Logging (verbose for debugging)
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SPRING=INFO
LOG_LEVEL_SQL=DEBUG